# FrankPass .gitignore
# Exclusions for public production repository

# OS files
.DS_Store
Thumbs.db

# Logs & temp
*.log
*.tmp

# Python test scripts & caches
*.py
__pycache__/
.pytest_cache/

# Dependencies
node_modules/

# Cloudflare & local deployment state
.wrangler/
.vercel/

# Environment files — NEVER commit these (contain secret API keys)
.env
.env.*
.env.local
.env.development.local
.env.production.local
.env.test.local

# Internal strategy & audits (keep in 04_Strategy_and_Docs)
_internal_docs/
_rollback_vault/

# Build outputs
dist/
build/
.next/
out/
